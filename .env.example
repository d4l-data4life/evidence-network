# Copy to `.env` and fill in. `.env` is gitignored.

# ── Database ─────────────────────────────────────────────────────────────────
# Local (host) tooling like `prisma migrate` connects to Postgres on localhost.
# Inside docker-compose the app talks to the `db` service host instead (see
# docker-compose.yml, which overrides this value).
DATABASE_URL="postgresql://evidence:evidence@localhost:5432/evidence?schema=public"

# Postgres container credentials (used by docker-compose to create the DB).
POSTGRES_USER=evidence
POSTGRES_PASSWORD=evidence
POSTGRES_DB=evidence

# ── Auth.js ──────────────────────────────────────────────────────────────────
# Secret used to sign/encrypt the session JWT. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-32-byte-base64-string"

# Public base URL of the app. Use the loopback hostname http://evidence.test:3000.
# `evidence.test` is a name YOU map to 127.0.0.1 via /etc/hosts (one-time):
#   echo "127.0.0.1 evidence.test" | sudo tee -a /etc/hosts
# The `.test` TLD is reserved by RFC 6761 — no one can own it and it never hits
# public DNS, so this works on any network and offline.
# Why not "localhost" or "127.0.0.1": ORCID's sandbox rejects the literal host
# "localhost" as a redirect URI, and Next.js internally rewrites 127.0.0.1 ->
# localhost, which breaks OAuth cookie/redirect_uri host matching. A custom host
# avoids both. Register the ORCID redirect URI as exactly
# http://evidence.test:3000/api/auth/callback/orcid, and open the app there.
AUTH_URL="http://evidence.test:3000"

# ── ORCID (federated login) ──────────────────────────────────────────────────
# Sandbox:    https://sandbox.orcid.org
# Production: https://orcid.org
ORCID_ISSUER="https://sandbox.orcid.org"
# From https://sandbox.orcid.org/developer-tools (format: APP-XXXXXXXXXXXXXXXX)
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
